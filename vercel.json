{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "staging": true
    }
  },
  "rewrites": [
    {
      "source": "/__clerk/(.*)",
      "destination": "/api/clerk-proxy?p=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
