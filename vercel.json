{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "staging": true
    }
  },
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':!docs' ':!AGENTS.md' ':!CLAUDE.md' ':!justfile' ':!.github' ':!.gitignore'",
  "rewrites": [
    {
      "source": "/__clerk/(.*)",
      "destination": "/api/clerk-proxy?p=$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
